{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "annotations": {
      "grafana.app/folder": "eftnndsaxtvy8a",
      "grafana.app/message": "Manage SOMA storage observability dashboard as code"
    },
    "name": "soma-storage-observability"
  },
  "spec": {
    "annotations": [],
    "cursorSync": "Off",
    "description": "Production health, traffic, latency, retries, safe failure logs, and traces for Soma's Supabase Storage boundaries.",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "grafanacloud-prom"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "100 * sum(rate(soma_storage_errors_total{workflow=~\"$workflow\",logical_area=~\"$logical_area\"}[5m])) / clamp_min(sum(rate(soma_storage_operations_total{workflow=~\"$workflow\",logical_area=~\"$logical_area\"}[5m])), 1e-9)",
                        "instant": true,
                        "format": "table",
                        "range": false
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "Failed provider attempts as a share of all observed provider attempts over 5 minutes. Retries count again; this is not a unique-session or business-failure rate.",
          "id": 1,
          "links": [],
          "title": "Provider attempt error ratio",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "unit": "percent",
                  "decimals": 1,
                  "noValue": "Unknown \u2014 not measured",
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "text"
                      },
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "orange",
                        "value": 1
                      },
                      {
                        "color": "red",
                        "value": 5
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "reduceOptions": {
                  "calcs": [
                    "lastNotNull"
                  ],
                  "fields": "",
                  "values": false
                },
                "textMode": "auto",
                "colorMode": "background",
                "graphMode": "area"
              }
            },
            "version": ""
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
